{
  "description": "Show server, tool, duration and ok/error after every MCP tool call. Active only while the subtask plugin is installed and enabled.",
  "hooks": {
    "PostToolUse": [
      { "matcher": "mcp__.*", "hooks": [{ "type": "command", "command": "python3 -I \"${CLAUDE_PLUGIN_ROOT}/hooks/mcp_timing.py\"", "timeout": 5 }] }
    ],
    "PostToolUseFailure": [
      { "matcher": "mcp__.*", "hooks": [{ "type": "command", "command": "python3 -I \"${CLAUDE_PLUGIN_ROOT}/hooks/mcp_timing.py\"", "timeout": 5 }] }
    ]
  }
}
