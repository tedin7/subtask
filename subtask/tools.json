{
 "instructions": "Delegate long work to cheap engines; do small things yourself (measured: small tasks cost 2-3x). Pattern: ONE start_many([...]) with every job, then ONE wait(ids): it blocks and returns the summaries. Never poll status(); call wait() again only if it said 'still running'. result(id, full/evidence) only when the summary is not enough. Call step() before each significant step.",
 "tools": [
  {
   "name": "start",
   "description": "Start a job. kind: read|code|review|hard. repo: new worktree. policy: worktree|sandbox|isolated|untrusted. verify: check command.",
   "inputSchema": {
    "properties": {
     "task": {
      "type": "string"
     },
     "kind": {
      "default": "code",
      "type": "string"
     },
     "repo": {
      "type": "string"
     },
     "cwd": {
      "type": "string"
     },
     "files": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "readonly": {
      "default": false,
      "type": "boolean"
     },
     "engine": {
      "default": "auto",
      "type": "string"
     },
     "max_usd": {
      "type": "number"
     },
     "effort": {
      "default": "medium",
      "type": "string"
     },
     "base": {
      "default": "HEAD",
      "type": "string"
     },
     "max_turns": {
      "default": 60,
      "type": "integer"
     },
     "policy": {
      "type": "string"
     },
     "verify": {
      "type": "string"
     }
    },
    "required": [
     "task"
    ],
    "type": "object"
   }
  },
  {
   "name": "start_many",
   "description": "Items take start()'s arguments.",
   "inputSchema": {
    "properties": {
     "tasks": {
      "items": {
       "additionalProperties": true,
       "type": "object"
      },
      "type": "array"
     }
    },
    "required": [
     "tasks"
    ],
    "type": "object"
   }
  },
  {
   "name": "wait",
   "description": "Wait for jobs; returns summaries. mode: all|any|first_success. since: cursor. Returns on a stalled job.",
   "inputSchema": {
    "properties": {
     "ids": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "timeout": {
      "default": 300,
      "type": "integer"
     },
     "any": {
      "default": false,
      "type": "boolean"
     },
     "since": {
      "type": "string"
     },
     "mode": {
      "type": "string"
     },
     "stall_timeout": {
      "type": "number"
     }
    },
    "required": [
     "ids"
    ],
    "type": "object"
   }
  },
  {
   "name": "status",
   "description": "One line per job.",
   "inputSchema": {
    "properties": {
     "id": {
      "type": "string"
     }
    },
    "type": "object"
   }
  },
  {
   "name": "result",
   "description": "Job summary; full=True for all; evidence=True for the JSON envelope.",
   "inputSchema": {
    "properties": {
     "id": {
      "type": "string"
     },
     "full": {
      "default": false,
      "type": "boolean"
     },
     "evidence": {
      "default": false,
      "type": "boolean"
     }
    },
    "required": [
     "id"
    ],
    "type": "object"
   }
  },
  {
   "name": "reply",
   "description": "Continue a finished job.",
   "inputSchema": {
    "properties": {
     "id": {
      "type": "string"
     },
     "message": {
      "type": "string"
     }
    },
    "required": [
     "id",
     "message"
    ],
    "type": "object"
   }
  },
  {
   "name": "stop",
   "description": "Stop a job.",
   "inputSchema": {
    "properties": {
     "id": {
      "type": "string"
     }
    },
    "required": [
     "id"
    ],
    "type": "object"
   }
  },
  {
   "name": "steer",
   "description": "action: hint (queued, sent when the attempt ends)|abort|retry (fresh job).",
   "inputSchema": {
    "properties": {
     "id": {
      "type": "string"
     },
     "action": {
      "type": "string"
     },
     "instruction": {
      "type": "string"
     }
    },
    "required": [
     "id",
     "action"
    ],
    "type": "object"
   }
  },
  {
   "name": "inspect",
   "description": "Raw log lines of a job, only when the summary is not enough.",
   "inputSchema": {
    "properties": {
     "id": {
      "type": "string"
     },
     "tail": {
      "default": 80,
      "type": "integer"
     },
     "grep": {
      "type": "string"
     }
    },
    "required": [
     "id"
    ],
    "type": "object"
   }
  },
  {
   "name": "cleanup",
   "description": "Remove a job's worktree, keep branch.",
   "inputSchema": {
    "properties": {
     "id": {
      "type": "string"
     }
    },
    "required": [
     "id"
    ],
    "type": "object"
   }
  },
  {
   "name": "engines",
   "description": "Free quota and API spend.",
   "inputSchema": {
    "properties": {},
    "type": "object"
   }
  },
  {
   "name": "step",
   "description": "Before each significant step. Paste the reply verbatim; on STOP ask the user.",
   "inputSchema": {
    "properties": {
     "title": {
      "type": "string"
     },
     "path": {
      "type": "string"
     },
     "how": {
      "type": "string"
     },
     "decisions": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "repo": {
      "type": "string"
     }
    },
    "required": [
     "title",
     "path",
     "how"
    ],
    "type": "object"
   }
  }
 ]
}
